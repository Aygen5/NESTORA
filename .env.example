# NESTORA Environment Configuration Example
# Copy this file or provide compile-time defines with:
# flutter run --dart-define=FIREBASE_WEB_API_KEY=your_key --dart-define=FIREBASE_ANDROID_API_KEY=your_key --dart-define=FIREBASE_IOS_API_KEY=your_key

FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
